<?xml version="1.0" encoding="utf-8"?>
<!--
    主界面布局：
    - 顶部状态卡（无障碍开关状态 + 完成进度 0/4）
    - 中间「开始签到」大按钮
    - 底部实时滚动日志框
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="vivo 会员自动签到"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="钱包 · 游戏中心 · 应用商店 · 官网登录"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- 状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="无障碍服务"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAccessibilityState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未开启"
                    android:textColor="@color/accent_red"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="完成进度"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 4"
                    android:textColor="@color/accent_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 当前任务状态 -->
        <TextView
            android:id="@+id/tvCurrentTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前任务：空闲"
            android:textColor="@color/accent_orange"
            android:textSize="14sp"
            android:padding="10dp"
            android:background="@color/bg_card"
            android:layout_marginBottom="16dp" />

        <!-- 开启无障碍按钮（默认隐藏，未开启时显示） -->
        <Button
            android:id="@+id/btnOpenAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_accessibility"
            android:visibility="gone"
            android:backgroundTint="@color/accent_orange"
            android:layout_marginBottom="8dp" />

        <!-- 开始签到大按钮 -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/btn_start"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/brand_primary" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_stop"
            android:backgroundTint="@color/accent_red"
            android:layout_marginTop="8dp" />

        <!-- 日志标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="实时日志"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />

        <!-- 实时滚动日志框 -->
        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="@color/bg_card"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/log_default"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
